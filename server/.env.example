# ================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO ZALO MULTI-ACCOUNT & AI CSKH
# ================================================================

# Cổng mạng server lắng nghe (Mặc định: 5000)
PORT=5000

# Chế độ môi trường
NODE_ENV=production

# Khóa bí mật ký JWT Token cho tài khoản Admin (Nên đổi chuỗi ngẫu nhiên dài và bảo mật)
# BẮT BUỘC: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cấu hình Pinecone Vector Database (TÙY CHỌN - để trống thì dùng tìm kiếm từ khóa cục bộ)
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx 
PINECONE_HOST=https://xxxxxxxxxxxxxxxxxxxxxx.pinecone.io
PINECONE_INDEX=xxx
